TARGET := jfbloodpsp_bootstrap
OBJS := platform/psp_bootstrap.o

# Kept here so that platform objects and the future game target use the same
# host-compiler compatibility mode. GCC 15 defaults to C23 on this host while
# the historical JFBuild code expects GNU C17 semantics.
PSP_BUILD_VARIANT ?= release
PSP_EXTRA_DEFINES ?=

ifeq ($(PSP_BUILD_VARIANT),diagnostic)
PSP_BUILD_DEFINES := -DPSP_DIAGNOSTIC_BUILD
PSP_PBP_TITLE := JFBlood PSP (Diagnostic)
else ifeq ($(PSP_BUILD_VARIANT),release)
PSP_BUILD_DEFINES := -DPSP_RELEASE_BUILD
PSP_PBP_TITLE := JFBlood PSP (MVP)
else
$(error PSP_BUILD_VARIANT must be release or diagnostic)
endif

CFLAGS += -std=gnu17 -DSMACKER_DISABLE $(PSP_BUILD_DEFINES) $(PSP_EXTRA_DEFINES) -I jfbuild-vita/include -I jfbuild-vita/src
CXXFLAGS += -std=gnu++14 -fpermissive -DSMACKER_DISABLE $(PSP_BUILD_DEFINES) $(PSP_EXTRA_DEFINES)

PSP_FW_VERSION := 600
BUILD_PRX := 1
EXTRA_TARGETS := EBOOT.PBP
PSP_EBOOT_TITLE := JFBlood PSP Bootstrap

include $(PSPSDK)/lib/build.mak

.PHONY: platform-check
platform-check: platform/psplayer.o

# The full game build is kept separate from the already validated bootstrap.
# It reuses the backport's object list but selects the PSP platform, JFBuild
# copy and the AudioLib no-sound backend (no SDL/PSP audio driver is built).
override PLATFORM := PSP
override RENDERTYPE := PSP
EROOT := jfbuild-vita
MACTROOT := jfmact
AUDIOLIBROOT := jfaudiolib
USE_POLYMOST := 0
USE_OPENGL := 0
USE_ASM := 0
RELEASE := 1
CC := psp-gcc
CXX := psp-g++
AR := psp-ar
RANLIB := psp-ranlib

include Makefile

platform/%.o: platform/%.cpp
	$(CXX) $(CXXFLAGS) $(OURCXXFLAGS) $(OURCFLAGS) -c $< -o $@

platform/%.o: platform/%.c
	$(CC) $(CFLAGS) $(OURCFLAGS) -c $< -o $@

# Network and Smacker are deliberately outside the PSP MVP.  The game-network
# object is replaced by a single-player stub at link time in the next stage.
GAMEOBJS := $(filter-out $(ENETOBJ) $(SMACKEROBJ) $(SRC)/network.$o,$(GAMEOBJS)) platform/network_stub.o
ENETOBJ :=
SMACKEROBJ :=

# The upstream rule invokes a nested make without forwarding the PSP tool
# names, which makes it accidentally discover host SDL. The PSP build enables
# its small native PCM driver; MIDI music remains deliberately unsupported.
$(AUDIOLIBROOT)/$(JFAUDIOLIB):
	$(MAKE) -C $(AUDIOLIBROOT) $(JFAUDIOLIB) RELEASE=$(RELEASE) CC=$(CC) AR=$(AR) CFLAGS="-std=gnu17 $(PSP_BUILD_DEFINES)" JFAUDIOLIB_HAVE_PSP=1 JFAUDIOLIB_HAVE_SDL=0 JFAUDIOLIB_HAVE_ALSA=0 JFAUDIOLIB_HAVE_VORBIS=0
	$(RANLIB) $@

.PHONY: blood-objects
blood-objects: $(GAMEOBJS) $(JMACTOBJ) $(AUDIOLIBROOT)/$(JFAUDIOLIB)

JFBLOOD_TARGET := jfbloodpsp
JFBLOOD_ELF := $(JFBLOOD_TARGET).elf
JFBLOOD_PRX := $(JFBLOOD_TARGET).prx
JFBLOOD_OBJS := $(GAMEOBJS) platform/psplayer.o platform/psp_ge.o platform/psp_ge_world.o platform/psp_posix_stubs.o
JFBLOOD_PERF_OBJ := platform/psp_perf.o
JFBLOOD_ENGINE := $(EROOT)/src/libengine.a

$(JFBLOOD_ENGINE):
	$(MAKE) -B -C $(EROOT) enginelib PLATFORM=PSP RENDERTYPE=PSP CC=$(CC) CXX=$(CXX) AR=$(AR) RANLIB=$(RANLIB) CFLAGS="-std=gnu17 -DENGINE_19960925" USE_POLYMOST=0 USE_OPENGL=0 USE_ASM=0 RELEASE=1

enginelib:
	$(MAKE) -B -C $(EROOT) enginelib PLATFORM=PSP RENDERTYPE=PSP CC=$(CC) CXX=$(CXX) AR=$(AR) RANLIB=$(RANLIB) CFLAGS="-std=gnu17 -DENGINE_19960925" USE_POLYMOST=0 USE_OPENGL=0 USE_ASM=0 RELEASE=1

$(JFBLOOD_ELF): blood-objects $(JFBLOOD_ENGINE) $(JFBLOOD_OBJS) $(JFBLOOD_PERF_OBJ)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $(JFBLOOD_OBJS) $(JFBLOOD_ENGINE) $(AUDIOLIBROOT)/$(JFAUDIOLIB) $(JFBLOOD_PERF_OBJ) -lm -lpspctrl -lpspdisplay -lpspgum -lpspgu -lpspge -lpsprtc -lpsppower -lpspaudio -lpspsdk -lpspuser

$(JFBLOOD_PRX): $(JFBLOOD_ELF)
	psp-fixup-imports $<
	psp-prxgen $< $@

.PHONY: blood-eboot blood-eboot-release blood-eboot-diagnostic blood-eboot-build

# A variant always forces a complete rebuild. This prevents a diagnostic object
# (and its instrumentation) from being linked into the silent release EBOOT.
blood-eboot: blood-eboot-release

blood-eboot-release:
	$(MAKE) -B -f Makefile.psp PSP_BUILD_VARIANT=release blood-eboot-build
	cp -f EBOOT.PBP EBOOT-release.PBP

blood-eboot-diagnostic:
	$(MAKE) -B -f Makefile.psp PSP_BUILD_VARIANT=diagnostic blood-eboot-build
	cp -f EBOOT.PBP EBOOT-diagnostic.PBP

blood-eboot-build: $(JFBLOOD_PRX)
	mksfoex "$(PSP_PBP_TITLE)" PARAM.SFO
	pack-pbp EBOOT.PBP PARAM.SFO NULL NULL NULL NULL NULL $(JFBLOOD_PRX) NULL
